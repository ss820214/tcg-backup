{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "old/**",
      "**/old/**",
      "**/_*",
      "_codex_backup_*/**",
      "public/_codex_backup_*/**",
      "過去ver置き場/**",
      "public/過去ver置き場/**",
      "**/*.bak_*",
      "**/*.mojibake_bak_*",
      "**/_remote_*",
      "**/_check_*"
    ],
    "rewrites": [
      {
        "source": "!**/*.{js,css,map,json,png,jpg,jpeg,svg,webp}",
        "destination": "/index.html"
      }
    ]
  }
}
