{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "old/**",
      "**/old/**",
      "**/_*",
      "_codex_backup_*/**",
      "public/_codex_backup_*/**",
      "過去ver置き場/**",
      "public/過去ver置き場/**",
      "**/*.bak_*",
      "**/*.mojibake_bak_*",
      "**/_remote_*",
      "**/_check_*"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/global_ui_20260821.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/deck_runtime_guard_20261003.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/deck_runtime_guard_v3_20261003.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/deck_mobile_density_20261003.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "!**/*.{js,css,map,json,png,jpg,jpeg,svg,webp}",
        "destination": "/index.html"
      }
    ]
  }
}
